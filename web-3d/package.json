{
  "name": "upt-indoor-navigator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "extract": "node scripts/extract-floor.mjs ../2_11_2025.glb src/map/floor.json && npm run doors && npm run stairs",
    "doors": "node scripts/detect-doors.mjs ../2_11_2025.glb src/map/floor.json",
    "stairs": "node scripts/detect-stairs.mjs ../2_11_2025.glb src/map/floor.json",
    "inspect": "node scripts/inspect-scan.mjs ../2_11_2025.glb src/map/floor.json inspect-out"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "lucide-react": "^1.77.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jpeg-js": "^0.4.4",
    "tailwindcss": "^4.3.5",
    "three-mesh-bvh": "^0.8.3",
    "typescript": "~5.6.3",
    "vite": "^5.4.21"
  }
}
